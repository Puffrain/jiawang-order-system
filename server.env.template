# 佳旺订单系统服务器配置模板
# 复制为服务器上的受控 .env 文件后填写；不要提交真实文件到 GitHub。

APP_ORIGIN=https://www.kunshanjiawang.cn
HTTP_PORT=8080

# 后台老板账号（请改成你自己的值）
OWNER_PHONE=填写后台登录手机号
OWNER_PHONE_ALIASES=可选的其他手机号
OWNER_PASSWORD=填写至少10位强密码
OWNER_NAME=store-owner

# 应用密钥：在服务器生成，不要发到聊天或提交仓库
SESSION_SECRET=填写随机字符串_至少32位
INTEGRATION_SHARED_SECRET=填写另一组随机字符串_至少32位
APP_MASTER_KEY=填写现有32字节Base64主密钥

# 微信小程序登录
WECHAT_MINI_APPID=填写小程序AppID
WECHAT_MINI_SECRET=填写小程序AppSecret

# 微信支付（新商户建议使用微信支付公钥验签）
WECHAT_PAY_MERCHANT_ID=填写微信支付商户号
WECHAT_PAY_API_V3_KEY=填写32位APIv3密钥
WECHAT_PAY_CERT_SERIAL=填写商户证书序列号
WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/wechat-pay-private-key.pem
WECHAT_PAY_PUBLIC_KEY_FILE=/run/secrets/wechat-pay-public-key.pem
WECHAT_PAY_PUBLIC_KEY_ID=填写微信支付公钥ID
WECHAT_PAY_NOTIFY_URL=https://www.kunshanjiawang.cn/api/payments/wechat/notify

# 可选：短信、AI、企业微信；不用时留空
SMS_PROVIDER=aliyun
SMS_PREVIEW_MODE=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TEXT_MODEL=
DEEPSEEK_VISION_MODEL=
DEEPSEEK_ALLOWED_HOSTS=
WECOM_BOT_WEBHOOK_URL=
WECOM_BOT_MENTION_MOBILE=
