# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-review-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
production.env*
server.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# luffy: SQLite 本地数据目录与运行日志
data/
/uploads/
*.log

# takeover, release and runtime state
/.task-backups/
/.task-runs/
/.local/
/backups/
/tmp/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.jwbackup
*.pem
*.key
*.p12
*.pfx
test-results/
playwright-report/
/output/playwright/
/.playwright-cli/

# 受控品牌素材：含真实人物/门店资料，只在本地开发者工具上传副本中使用
/miniprogram/assets/*
!/miniprogram/assets/.gitkeep
