{
  "name": "wholesale-crm",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "SMS_PREVIEW_MODE=true next dev --webpack -H 0.0.0.0",
    "migrate": "node scripts/migrate-commerce-schema.cjs",
    "migrate:order-lifecycle": "node scripts/migrate-order-lifecycle.cjs",
    "test:migration-order-lifecycle": "node scripts/test-order-lifecycle-migration.cjs",
    "test:migration-commerce": "node scripts/test-commerce-migration.cjs",
    "test:customer-profile-legacy": "node scripts/test-customer-profile-legacy-db.cjs",
    "validate:compose-build": "node scripts/validate-compose-build.mjs",
    "test:deployment-config": "node scripts/deployment-config-smoke.mjs",
    "test:miniprogram-contract": "node scripts/miniprogram-contract.mjs",
    "miniprogram:preflight": "node scripts/miniprogram-release-preflight.mjs",
    "miniprogram:prepare-upload": "node scripts/miniprogram-release-preflight.mjs --prepare",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "backup:sqlite": "node scripts/sqlite-online-backup.cjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:security": "node tests/security/auth-baseline.mjs",
    "test:router-chunks": "node tests/e2e/router-chunk-baseline.mjs",
    "test:product-flow": "node tests/e2e/product-management-flow.mjs",
    "test:customer-auth": "node tests/e2e/customer-auth-flow.mjs",
    "test:order-visibility": "node tests/e2e/order-visibility-flow.mjs",
    "test:formal-entry": "node tests/e2e/formal-entry-diagnostic.mjs",
    "test:admin-password": "node tests/e2e/admin-password-flow.mjs",
    "test:warehouse-integration": "node tests/integration/warehouse-contract.mjs",
    "test:cross-system": "node tests/integration/cross-system-sync-contract.mjs",
    "test:product-archive-sync": "node tests/integration/product-archive-sync-contract.mjs",
    "test:chat-order-navigation": "node tests/integration/chat-order-navigation-contract.mjs",
    "test:buyer-responsive-layout": "node tests/integration/buyer-responsive-layout-contract.mjs",
    "test:loyalty": "node --import tsx tests/integration/loyalty-ledger.mjs",
    "test:warehouse-projection": "node --import tsx tests/integration/warehouse-projection-runtime.mts",
    "test:warehouse-media": "node --import tsx tests/integration/warehouse-media-concurrency-runtime.mts",
    "test:db-bootstrap": "node --import tsx tests/integration/database-concurrent-bootstrap.mts",
    "test:production-data-check": "node tests/integration/production-data-check-runtime.mjs",
    "test:wecom-mentions": "node --import tsx tests/integration/wecom-mentions.mts",
    "test:courier-payment": "node tests/integration/courier-payment-contract.mjs",
    "test:wechat-pay": "node --import tsx tests/integration/wechat-pay-contract.mjs",
    "worker:media": "tsx scripts/media-worker.ts",
    "test:customer-profile-address": "node tests/e2e/customer-profile-address-flow.mjs",
    "test:order-status-zh": "node --experimental-strip-types tests/e2e/order-status-zh-flow.mjs",
    "test:voice-chat": "node tests/e2e/voice-chat-flow.mjs",
    "test:capacity": "node tests/load/customer-capacity.mjs",
    "test:chat-capacity": "node tests/load/chat-polling-capacity.mjs",
    "test:load": "pnpm run test:capacity && pnpm run test:chat-capacity",
    "test:business-flows": "pnpm run test:customer-auth && pnpm run test:customer-profile-address && pnpm run test:product-flow && pnpm run test:order-visibility",
    "test:regression": "pnpm run test:router-chunks && pnpm run test:security"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
