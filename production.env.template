# Jiawang production environment template
# Copy to a protected server-side .env file. Do not commit or transmit real values.

APP_ORIGIN=https://www.kunshanjiawang.cn
HTTP_PORT=8080

OWNER_PHONE=填写后台登录手机号
OWNER_PHONE_ALIASES=可选的其他手机号
OWNER_PASSWORD=replace-with-a-strong-password-at-least-10-characters
OWNER_NAME=store-owner

# Generate separately with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters
# Generate separately with: openssl rand -hex 32
INTEGRATION_SHARED_SECRET=replace-with-a-different-random-string-at-least-32-characters
# Keep the existing production key until encrypted database values are migrated.
APP_MASTER_KEY=replace-with-the-existing-32-byte-base64-key

SMS_PROVIDER=aliyun
SMS_PREVIEW_MODE=false
ALIYUN_SMS_ACCESS_KEY_ID=replace-with-your-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
ALIYUN_SMS_SIGN_NAME=replace-with-your-sms-sign-name
ALIYUN_SMS_TEMPLATE_CODE=replace-with-your-sms-template-code
ALIYUN_SMS_REGION_ID=cn-hangzhou

DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.example.com
DEEPSEEK_MODEL=replace-with-your-text-model
DEEPSEEK_TEXT_MODEL=replace-with-your-text-model
DEEPSEEK_VISION_MODEL=replace-with-your-vision-model
DEEPSEEK_ALLOWED_HOSTS=api.example.com

# 企业微信群机器人（可选）；真实 Webhook 只放服务器 .env，不要提交到源码。
WECOM_BOT_WEBHOOK_URL=
WECOM_BOT_MENTION_MOBILE=

# 微信小程序登录
WECHAT_MINI_APPID=填写小程序AppID
WECHAT_MINI_SECRET=填写小程序AppSecret

# 微信支付：新商户建议使用微信支付公钥验签
WECHAT_PAY_MERCHANT_ID=填写微信支付商户号
WECHAT_PAY_API_V3_KEY=填写32位APIv3密钥
WECHAT_PAY_CERT_SERIAL=填写商户证书序列号
WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/wechat-pay-private-key.pem
WECHAT_PAY_PUBLIC_KEY_FILE=/run/secrets/wechat-pay-public-key.pem
WECHAT_PAY_PUBLIC_KEY_ID=填写微信支付公钥ID
WECHAT_PAY_NOTIFY_URL=https://www.kunshanjiawang.cn/api/payments/wechat/notify
