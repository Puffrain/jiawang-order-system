.order-card { margin-bottom: 18rpx; }.order-no { font-weight: 700; }.status { color: #ea580c; font-size: 24rpx; }.order-time { margin-top: 12rpx; font-size: 22rpx; }.order-total { margin-top: 22rpx; }.total { color: #ea580c; font-weight: 700; }.actions { margin-top: 20rpx; }.actions button { display: inline-block; margin: 0 12rpx 0 0; padding: 8rpx 18rpx; font-size: 23rpx; }.center { text-align: center; padding: 80rpx 0; }
.filter-tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; overflow-x: auto; }.filter-tab { flex: 0 0 auto; margin: 0; padding: 12rpx 24rpx; border: 1rpx solid #e5e7eb; background: #fff; color: #74808c; font-size: 24rpx; }.filter-tab.selected { border-color: #fb923c; background: #fff4eb; color: #ea580c; }.mini-nav { position: sticky; bottom: 0; z-index: 5; display: flex; gap: 8rpx; margin: 28rpx -28rpx -28rpx; padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf1; background: rgba(255,255,255,.96); }.mini-nav-item { flex: 1; margin: 0; padding: 12rpx 4rpx; border-radius: 12rpx; background: transparent; color: #74808c; font-size: 23rpx; }.mini-nav-item.active { background: #fff4eb; color: #ea580c; }
