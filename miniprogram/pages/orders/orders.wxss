.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }.brand-strip, .filter-tabs, .error { flex: 0 0 auto; }.order-scroll { flex: 1; min-height: 0; }.order-card { margin-bottom: 18rpx; }.order-no { font-weight: 700; }.status { color: #ea580c; font-size: 24rpx; }.order-time { margin-top: 12rpx; font-size: 22rpx; }.order-total { margin-top: 22rpx; }.total { color: #ea580c; font-weight: 700; }.actions { margin-top: 20rpx; }.actions button { display: inline-block; margin: 0 12rpx 0 0; padding: 8rpx 18rpx; font-size: 23rpx; }.center { text-align: center; padding: 80rpx 0; }
.filter-tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; overflow-x: auto; }.filter-tab { flex: 0 0 auto; margin: 0; padding: 12rpx 24rpx; border: 1rpx solid #e5e7eb; background: #fff; color: #74808c; font-size: 24rpx; }.filter-tab.selected { border-color: #fb923c; background: #fff4eb; color: #ea580c; }.mini-nav { flex: 0 0 auto; z-index: 5; display: flex; gap: 6rpx; margin: 0 -28rpx -28rpx; padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf1; background: rgba(255,255,255,.96); }.mini-nav-item { flex: 1; min-width: 0; margin: 0; padding: 12rpx 2rpx; border-radius: 12rpx; background: transparent; color: #74808c; font-size: 22rpx; }.mini-nav-item.active { background: #fff4eb; color: #ea580c; }
