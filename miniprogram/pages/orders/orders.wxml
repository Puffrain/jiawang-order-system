<view class="page"><view class="brand-strip"><view class="brand-name">我的订单</view><view class="brand-caption">查看审核、配送和收货进度</view></view><view wx:if="{{loading}}" class="muted center">正在加载...</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{orders}}" wx:key="id" class="card order-card"><view class="row"><text class="order-no">{{item.orderNo}}</text><text class="status">{{item.statusLabel || item.status}}</text></view><view class="muted order-time">{{item.createdAt}}</view><view class="row order-total"><text>订单金额</text><text class="total">¥{{item.totalAmount}}</text></view><view class="actions"><button wx:if="{{item.status === 'pending_review'}}" class="ghost" data-id="{{item.id}}" data-action="cancel" bindtap="action">取消订单</button><button wx:if="{{item.status === 'pending_review'}}" class="ghost" data-id="{{item.id}}" data-action="withdraw" bindtap="action">修改订单</button><button wx:if="{{item.confirmationStatus === 'buyer_review'}}" class="primary" data-id="{{item.id}}" data-action="confirm" bindtap="action">确认订单</button><button wx:if="{{item.fulfillmentStatus === 'delivered' && item.paymentStatus === 'paid'}}" class="primary" data-id="{{item.id}}" data-action="receive" bindtap="action">确认收货</button><button wx:if="{{item.status === 'closed' || item.status === 'cancelled'}}" class="danger" data-id="{{item.id}}" data-action="hide" bindtap="action">隐藏订单</button></view></view><view wx:if="{{!orders.length && !loading}}" class="muted center">暂无订单</view></view>

