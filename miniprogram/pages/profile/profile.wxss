.profile-page{padding-bottom:140rpx}.profile-hero{display:flex;align-items:center;padding:44rpx 32rpx;background:#1f2937;color:#fff}.avatar-button{padding:0;background:none}.avatar{width:136rpx;height:136rpx;border-radius:50%;background:#f59e0b;color:#fff;display:flex;align-items:center;justify-content:center;font-size:52rpx}.identity{margin-left:24rpx}.display-name{font-size:40rpx;font-weight:600}.phone{margin-top:10rpx;opacity:.8}.onboarding-hint{margin:20rpx 24rpx 0;padding:18rpx 20rpx;background:#fff8e8;color:#8a5214;border-radius:10rpx;font-size:24rpx;line-height:1.5}.form{margin:24rpx 24rpx 16rpx;padding:28rpx}.section-title{font-weight:600;margin-bottom:18rpx}.field{height:84rpx;border-bottom:1px solid #e5e7eb;margin-bottom:14rpx}.save{margin-top:12rpx}.quick-links{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;padding:16rpx 24rpx}.quick-links button{background:#fff;text-align:left;padding:24rpx;border-radius:12rpx}.logout{margin:18rpx 24rpx;color:#dc2626;background:#fff}.placeholder{font-weight:600}.mini-nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1px solid #e5e7eb;z-index:10}.mini-nav-item{flex:1;font-size:24rpx;padding:18rpx 0;background:#fff}.mini-nav-item.active{color:#d97706}
