<view class="page profile-page">
  <view class="profile-hero">
    <button class="avatar-button" bindtap="chooseAvatar"><image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar placeholder">{{avatarLetter}}</view></button>
    <view class="identity"><view class="display-name">{{profile.displayName || '完善个人资料'}}</view><view class="phone">{{profile.phone || '未绑定手机号'}}</view></view>
  </view>
  <view wx:if="{{onboarding}}" class="onboarding-hint">首次使用请完成资料和收货地址后再开始采购</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="form card">
    <view class="section-title">基本资料</view>
    <input class="field" value="{{profile.displayName}}" bindinput="inputName" placeholder="姓名 / 昵称" maxlength="60"/>
    <input class="field" value="{{profile.shopName}}" bindinput="inputShop" placeholder="店铺名称" maxlength="100"/>
    <input class="field" value="{{profile.businessType}}" bindinput="inputType" placeholder="经营类型，如美发店、美容院" maxlength="60"/>
    <button class="primary save" loading="{{saving}}" bindtap="save">保存资料</button>
  </view>
  <view wx:if="{{!onboarding}}" class="quick-links">
    <button bindtap="openOrders">我的订单</button><button bindtap="openPoints">积分余额 {{points}}</button><button bindtap="openAddress">收货地址</button><button bindtap="openMessages">消息中心</button>
  </view>
  <button class="logout" bindtap="logout">退出登录</button>
  <view wx:if="{{!onboarding}}" class="mini-nav"><button class="mini-nav-item" bindtap="openHome">首页</button><button class="mini-nav-item" bindtap="openCart">购物车</button><button class="mini-nav-item" bindtap="openMessages">消息</button><button class="mini-nav-item" bindtap="openOrders">订单</button><button class="mini-nav-item active">我的</button></view>
</view>
