<view class="page"><view class="brand-strip"><view class="brand-name">收货地址</view><view class="brand-caption">下单时选择配送地址</view></view><view class="row section"><view class="title">地址簿</view><button class="ghost add" bindtap="addAddress">微信地址簿</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{addresses}}" wx:key="id" class="card address-card" data-id="{{item.id}}" bindtap="choose"><view class="row"><view><text class="recipient">{{item.recipientName}}</text><text class="phone">{{item.phone}}</text></view><text wx:if="{{item.isDefault}}" class="default">默认</text></view><view class="muted address-text">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view><view wx:if="{{checkout}}" class="choose-hint">点击使用此地址</view></view><view wx:if="{{!addresses.length && !loading}}" class="muted center">还没有收货地址，请先添加</view></view>

