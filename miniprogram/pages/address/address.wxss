.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }.brand-strip, .row.section, .error { flex: 0 0 auto; }.address-scroll { flex: 1; min-height: 0; }.add { margin: 0; padding: 8rpx 18rpx; font-size: 23rpx; }.address-card { margin-bottom: 18rpx; }.recipient { font-weight: 700; }.phone { margin-left: 20rpx; color: #4b5563; }.default { color: #ea580c; font-size: 22rpx; }.address-text { margin-top: 18rpx; line-height: 1.6; }.choose-hint { margin-top: 16rpx; color: #ea580c; font-size: 23rpx; }.center { text-align: center; padding: 80rpx 0; }.mini-nav { flex: 0 0 auto; z-index: 5; display: flex; gap: 6rpx; margin: 0 -28rpx -28rpx; padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf1; background: rgba(255,255,255,.96); }.mini-nav-item { flex: 1; min-width: 0; margin: 0; padding: 12rpx 2rpx; border-radius: 12rpx; background: transparent; color: #74808c; font-size: 22rpx; }.mini-nav-item.active { background: #fff4eb; color: #ea580c; }
.address-heading { align-items: flex-start; flex-wrap: wrap; }.address-actions { display: flex; flex: 1; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }.address-actions .primary { min-height: 72rpx; }.manual-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(15,23,42,.48); }.manual-sheet { display: flex; flex-direction: column; width: 100%; max-height: 92vh; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 20rpx 20rpx 0 0; background: var(--jw-surface); }.manual-header { flex: 0 0 auto; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--jw-border); }.manual-title { font-size: 34rpx; font-weight: 700; }.manual-caption { margin-top: 6rpx; font-size: 23rpx; }.close-button { min-height: 64rpx; margin: 0; padding: 6rpx 16rpx; background: transparent; color: var(--jw-muted); font-size: 24rpx; }.manual-fields { flex: 1; min-height: 0; padding: 22rpx 0; }.field { margin-bottom: 20rpx; }.field > text { display: block; margin-bottom: 10rpx; font-size: 25rpx; font-weight: 600; }.field input, .field textarea { width: 100%; padding: 18rpx 20rpx; box-sizing: border-box; border: 1rpx solid var(--jw-border); border-radius: 12rpx; background: var(--jw-surface-subtle); }.field textarea { min-height: 150rpx; }.region-fields { display: block; }.default-check { display: flex; align-items: center; gap: 12rpx; margin: 4rpx 0 20rpx; font-size: 25rpx; }.save-manual { flex: 0 0 auto; width: 100%; margin: 0; }
