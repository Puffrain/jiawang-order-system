.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }.brand-strip, .row.section, .error { flex: 0 0 auto; }.address-scroll { flex: 1; min-height: 0; }.add { margin: 0; padding: 8rpx 18rpx; font-size: 23rpx; }.address-card { margin-bottom: 18rpx; }.recipient { font-weight: 700; }.phone { margin-left: 20rpx; color: #4b5563; }.default { color: #ea580c; font-size: 22rpx; }.address-text { margin-top: 18rpx; line-height: 1.6; }.choose-hint { margin-top: 16rpx; color: #ea580c; font-size: 23rpx; }.center { text-align: center; padding: 80rpx 0; }.mini-nav { flex: 0 0 auto; z-index: 5; display: flex; gap: 6rpx; margin: 0 -28rpx -28rpx; padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf1; background: rgba(255,255,255,.96); }.mini-nav-item { flex: 1; min-width: 0; margin: 0; padding: 12rpx 2rpx; border-radius: 12rpx; background: transparent; color: #74808c; font-size: 22rpx; }.mini-nav-item.active { background: #fff4eb; color: #ea580c; }
