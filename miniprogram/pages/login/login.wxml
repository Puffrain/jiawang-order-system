<view class="page login-page">
  <image class="brand-banner" src="/assets/brand-banner.jpg" mode="aspectFill"/>
  <view class="brand-strip"><view class="brand-name">佳旺美容美发用品店</view><view class="brand-caption">同城美发店 · 专属批发平台 · 免费送货上门</view></view>
  <view class="login-panel card">
    <view class="title">客户登录</view>
    <button wx:if="{{!loginTicket}}" class="primary login-button" loading="{{loading}}" bindtap="login">微信登录</button>
    <view wx:else class="phone-bind">
      <view class="bind-title">绑定手机号</view>
      <input class="phone-input" type="number" maxlength="11" value="{{phone}}" bindinput="inputPhone" placeholder="请输入 11 位手机号"/>
      <view class="code-row"><input class="code-input" type="number" maxlength="6" value="{{code}}" bindinput="inputCode" placeholder="短信验证码"/><button class="code-button" disabled="{{loading || countdown > 0}}" bindtap="sendCode">{{countdown ? countdown + '秒' : '获取验证码'}}</button></view>
      <view wx:if="{{developmentCode}}" class="development-code">开发测试码：{{developmentCode}}</view>
      <button class="primary login-button" loading="{{loading}}" bindtap="bindPhone">{{challengeId ? '验证并进入商城' : '发送验证码'}}</button>
    </view>
    <button class="ghost courier-entry" bindtap="courierLogin">配送员入口</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view class="muted legal">登录即表示你同意使用本系统处理订单和收货信息</view>
</view>
