<view class="page login-page">
  <image class="brand-banner" src="/assets/brand-banner.jpg" mode="aspectFill"/>
  <view class="brand-strip"><view class="brand-name">佳旺美容美发用品店</view><view class="brand-caption">同城美发店 · 专属批发平台 · 免费送货上门</view></view>
  <view class="login-panel card">
    <view class="title">客户登录</view>
    <view class="muted intro">使用微信快速进入订货平台</view>
    <button class="primary login-button" loading="{{loading}}" bindtap="login">微信登录</button>
    <button class="ghost courier-entry" bindtap="courierLogin">配送员入口</button>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view class="muted legal">登录即表示你同意使用本系统处理订单和收货信息</view>
</view>
