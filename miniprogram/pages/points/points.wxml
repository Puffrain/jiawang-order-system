<view class="page points-page"><view class="points-hero"><view class="label">可用积分</view><view class="balance">{{balance}}</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="ledger card" wx:for="{{ledger}}" wx:key="id"><view><view>{{item.reason}}</view><view class="muted">{{item.createdAt}}</view></view><view class="amount {{item.delta >= 0 ? 'plus' : 'minus'}}">{{item.delta >= 0 ? '+' : ''}}{{item.delta}}</view></view></view>
