<view class="page">
  <view wx:if="{{loading}}" class="muted center">正在加载商品...</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{product}}">
    <swiper class="gallery" indicator-dots="{{true}}"><swiper-item wx:for="{{product.images}}" wx:key="id"><image src="{{item.imageUrl}}" mode="aspectFill"/></swiper-item></swiper>
    <view class="card section"><view class="title">{{product.name}}</view><view class="muted product-meta">{{product.brand || '佳旺精选'}} · {{product.category}}</view><view class="description">{{product.description || '暂无商品说明'}}</view></view>
    <view class="card section"><view class="sub-title">选择规格</view><view class="sku-list"><button wx:for="{{product.skus}}" wx:key="id" class="sku {{selectedSku.id === item.id ? 'sku-selected' : ''}}" data-id="{{item.id}}" bindtap="selectSku">{{item.specName}} · ¥{{item.basePrice}}</button></view><view class="stock muted">库存 {{selectedSku.stock}} 件</view><view class="quantity row"><view>数量</view><view class="stepper"><button data-step="-1" bindtap="changeQuantity">−</button><text>{{quantity}}</text><button data-step="1" bindtap="changeQuantity">＋</button></view></view></view>
    <view class="bottom-bar"><button class="ghost" bindtap="openCart">购物车</button><button class="primary" bindtap="addToCart">加入购物车</button></view>
  </block>
</view>
