.gallery, .gallery image { width: 100%; height: 520rpx; background: #f1f4f5; }
.gallery { border-radius: 16rpx; overflow: hidden; border: 1rpx solid var(--jw-border); }
.gallery { margin: -28rpx -28rpx 24rpx; width: calc(100% + 56rpx); }
.gallery-placeholder { display: flex; align-items: center; justify-content: center; color: #82909b; font-size: 28rpx; font-weight: 600; }
.product-meta { margin-top: 12rpx; }.review-summary{margin-top:16rpx;color:var(--jw-warning);font-weight:600}.description { margin-top: 24rpx; line-height: 1.7; white-space: pre-wrap; }
.sku { border: 1rpx solid var(--jw-border); border-radius: 10rpx; }
.sku-selected { border-color: var(--jw-brand) !important; background: var(--jw-brand-soft); color: var(--jw-brand-strong); }
.stepper button { display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--jw-border); color: var(--jw-text); font-size: 34rpx; line-height: 1; }
.stepper text { font-weight: 700; }
.bottom-bar { position: fixed; right: 28rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 28rpx; z-index: 10; padding: 14rpx; border: 1rpx solid var(--jw-border); border-radius: 16rpx; background: rgba(255,255,255,.98); box-shadow: 0 10rpx 24rpx rgba(31,41,51,.12); }
.bottom-bar button { min-width: 0; }
