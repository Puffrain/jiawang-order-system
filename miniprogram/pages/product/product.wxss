.gallery, .gallery image { width: 100%; height: 520rpx; background: #f1f4f5; }
.gallery { margin: -28rpx -28rpx 24rpx; width: calc(100% + 56rpx); }
.gallery-placeholder { display: flex; align-items: center; justify-content: center; color: #82909b; font-size: 28rpx; font-weight: 600; }
.product-meta { margin-top: 12rpx; }.description { margin-top: 24rpx; line-height: 1.7; white-space: pre-wrap; }
.sub-title { font-weight: 700; }.sku-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }.sku { margin: 0; padding: 12rpx 18rpx; font-size: 24rpx; background: #f9fafb; color: #374151; }.sku-selected { background: #fff7ed; color: #c2410c; border: 1rpx solid #fb923c; }.stock { margin-top: 18rpx; font-size: 24rpx; }.quantity { margin-top: 24rpx; }.stepper { display: flex; align-items: center; gap: 18rpx; }.stepper button { width: 58rpx; height: 58rpx; line-height: 54rpx; padding: 0; background: #f3f4f6; }.stepper text { min-width: 40rpx; text-align: center; }.bottom-bar { position: sticky; bottom: 20rpx; display: flex; gap: 18rpx; }.bottom-bar button { flex: 1; margin: 0; }.center { text-align: center; padding: 80rpx 0; }
