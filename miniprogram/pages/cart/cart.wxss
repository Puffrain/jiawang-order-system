.cart-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }.brand-strip { flex: 0 0 auto; }.cart-scroll { flex: 1; min-height: 0; }.cart-item { margin-bottom: 18rpx; }.item-name { font-weight: 700; }.line-total, .total { color: #ea580c; font-weight: 700; }.item-actions { margin-top: 20rpx; }.stepper { display: flex; align-items: center; gap: 14rpx; }.stepper button { width: 54rpx; height: 54rpx; line-height: 50rpx; padding: 0; background: #f3f4f6; }.stepper text { min-width: 36rpx; text-align: center; }.mini { margin: 0; padding: 8rpx 18rpx; font-size: 22rpx; }.invalid, .error { margin: 14rpx 0; padding: 18rpx; border-radius: 12rpx; background: #fef2f2; color: #b91c1c; }.summary { margin-top: 22rpx; }.summary textarea { width: 100%; min-height: 130rpx; margin-top: 22rpx; padding: 18rpx; box-sizing: border-box; background: #f9fafb; }.checkout { margin-top: 22rpx; }.center { text-align: center; padding: 80rpx 0; }.cart-empty { min-height: 380rpx; box-sizing: border-box; }
.mini-nav { flex: 0 0 auto; z-index: 5; display: flex; gap: 6rpx; margin: 0 -28rpx -28rpx; padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf1; background: rgba(255,255,255,.96); }.mini-nav-item { flex: 1; min-width: 0; margin: 0; padding: 12rpx 2rpx; border-radius: 12rpx; background: transparent; color: #74808c; font-size: 22rpx; }.mini-nav-item.active { background: #fff4eb; color: #ea580c; }
