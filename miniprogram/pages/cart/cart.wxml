<view class="page"><view class="title section">购物车</view><view wx:if="{{loading}}" class="muted center">正在加载...</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{items}}" wx:key="skuId" class="card cart-item"><view class="row"><view class="item-main"><view class="item-name">{{item.productName}}</view><view class="muted">{{item.specName}} · ¥{{item.unitPrice}}</view></view><view class="line-total">¥{{item.lineTotal}}</view></view><view class="row item-actions"><view class="stepper"><button data-item="{{item}}" data-step="-1" bindtap="changeQuantity">−</button><text>{{item.quantity}}</text><button data-item="{{item}}" data-step="1" bindtap="changeQuantity">＋</button></view><button class="danger mini" data-id="{{item.skuId}}" bindtap="remove">删除</button></view></view><view wx:for="{{invalidItems}}" wx:key="skuId" class="invalid">{{item.productName}}：{{item.reason}}</view><view wx:if="{{items.length}}" class="card summary"><view class="row"><text>商品小计</text><text class="total">¥{{total}}</text></view><textarea placeholder="给商家的备注（选填）" value="{{remark}}" bindinput="inputRemark" maxlength="300"/></view><button wx:if="{{items.length}}" class="primary checkout" bindtap="checkout">选择地址并提交订单</button><view wx:else-if="{{!loading}}" class="muted center">购物车还是空的</view></view>
