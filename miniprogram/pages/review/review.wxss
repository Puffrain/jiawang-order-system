.rating-row{display:flex;gap:20rpx;margin:28rpx 0}.star{font-size:54rpx;color:#c6ced4}.star.active{color:var(--jw-warning)}.review-input{width:100%;min-height:260rpx;padding:20rpx;box-sizing:border-box;background:var(--jw-surface-subtle);border:1rpx solid var(--jw-border);border-radius:12rpx;line-height:1.6}.submit{width:100%;margin-top:24rpx}
.rating-row { gap: 8rpx; }.rating-row .star { flex: 1; min-width: 0; height: 88rpx; margin: 0; padding: 0; line-height: 88rpx; background: transparent; }.star::after { border: 0; }.title { overflow-wrap: anywhere; }
