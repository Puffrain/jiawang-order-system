.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.brand-banner { flex: 0 0 auto; height: 196rpx; }
.section { flex: 0 0 auto; }
.notice-card { display: flex; gap: 16rpx; align-items: flex-start; padding: 22rpx 24rpx; border: 1rpx solid #f7d2b8; border-radius: 14rpx; background: #fffaf6; }
.notice-title { flex: 0 0 auto; color: #d95813; font-size: 25rpx; font-weight: 700; }
.notice-body { min-width: 0; }
.notice-copy { color: #36434d; font-size: 25rpx; font-weight: 700; line-height: 1.5; }
.notice-summary { margin-top: 5rpx; color: #6d7b86; font-size: 23rpx; line-height: 1.5; }
.search-box { flex: 0 0 auto; display: flex; align-items: center; height: 76rpx; margin: 0 28rpx 16rpx; padding: 0 20rpx; border-radius: 12rpx; background: #fff; border: 1rpx solid #e3e9ed; }
.search-icon { margin-right: 12rpx; color: #8b98a2; font-size: 34rpx; line-height: 1; }
.search-box input { flex: 1; height: 100%; color: #25313a; font-size: 26rpx; }
.search-placeholder { color: #9aa6af; }
.sort-bar { flex: 0 0 auto; display: flex; height: 64rpx; margin: 0 28rpx 16rpx; border-bottom: 1rpx solid #e5eaee; }
.sort-item { flex: 1; position: relative; color: #687783; font-size: 25rpx; line-height: 62rpx; text-align: center; }
.sort-item.active { color: #d95813; font-weight: 700; }
.sort-item.active::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 44rpx; height: 4rpx; margin-left: -22rpx; border-radius: 2rpx; background: #f47721; }
.center { text-align: center; padding: 60rpx 0; }
.catalog-shell { display: flex; flex: 1; min-height: 0; margin: 0 -28rpx; border-top: 1rpx solid #e8edf1; }
.category-list { flex: 0 0 178rpx; height: 100%; background: #f4f6f8; }
.category-item { min-height: 96rpx; padding: 22rpx 18rpx; color: #62717c; font-size: 25rpx; line-height: 1.35; text-align: center; }
.category-item.active { color: #d95813; font-weight: 700; background: #fff; border-left: 6rpx solid #f47721; }
.product-list { flex: 1; min-width: 0; height: 100%; padding: 0 18rpx 24rpx; background: #fff; }
.product-row { display: flex; min-height: 212rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf0f2; }
.product-image { flex: 0 0 168rpx; width: 168rpx; height: 168rpx; border-radius: 8rpx; background: #f1f4f5; }
.image-placeholder { display: flex; align-items: center; justify-content: center; color: #82909b; font-size: 24rpx; font-weight: 600; }
.product-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 18rpx; overflow: hidden; }
.product-name { max-width: 100%; overflow: hidden; color: #1f2933; font-size: 28rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.product-description { min-height: 36rpx; margin-top: 8rpx; overflow: hidden; color: #75828c; font-size: 23rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.product-stock { margin-top: 4rpx; color: #8b98a2; font-size: 22rpx; }
.product-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: auto; }
.price { color: #e55c12; font-size: 30rpx; font-weight: 700; line-height: 1; }
.add-button { display: flex; flex: 0 0 52rpx; align-items: center; justify-content: center; width: 52rpx; min-width: 52rpx; height: 52rpx; margin: 0; padding: 0; border-radius: 50%; background: #f47721; color: #fff; font-size: 38rpx; font-weight: 400; line-height: 1; }
.empty-state { padding: 100rpx 20rpx; color: #82909b; text-align: center; font-size: 26rpx; }
.mini-nav { flex: 0 0 auto; z-index: 5; display: flex; gap: 6rpx; margin: 0 -28rpx -28rpx; padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e8edf1; background: rgba(255,255,255,.96); }
.mini-nav-item { flex: 1; min-width: 0; margin: 0; padding: 12rpx 2rpx; border-radius: 12rpx; background: transparent; color: #74808c; font-size: 22rpx; }
.mini-nav-item.active { background: #fff4eb; color: #ea580c; }
