.hero { background: #111827; color: #fff; padding: 34rpx; }
.eyebrow { color: #fdba74; font-size: 24rpx; }
.hero-title { margin: 18rpx 0 10rpx; font-size: 42rpx; font-weight: 700; }
.hero .muted { color: #d1d5db; }
.quick-actions { display: flex; gap: 16rpx; }
.quick-actions button { flex: 1; padding: 0; font-size: 24rpx; }
.section-title { font-size: 34rpx; }
.center { text-align: center; padding: 60rpx 0; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.product-card { padding: 0 0 22rpx; overflow: hidden; }
.product-card image, .image-placeholder { width: 100%; height: 250rpx; display: block; }
.image-placeholder { background: #ffedd5; color: #c2410c; text-align: center; line-height: 250rpx; font-size: 36rpx; font-weight: 700; }
.product-name { margin: 18rpx 18rpx 8rpx; font-weight: 700; line-height: 1.4; }
.product-card .muted, .price { margin: 0 18rpx; font-size: 23rpx; }
.price { margin-top: 14rpx; color: #ea580c; font-size: 30rpx; font-weight: 700; }
