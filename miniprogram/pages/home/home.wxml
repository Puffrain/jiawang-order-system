<view class="page">
  <view wx:if="{{notice}}" class="notice-card section"><view class="notice-icon">!</view><view class="notice-body"><view class="notice-title">活动通知</view><view class="notice-copy">{{notice.title}}</view><view wx:if="{{notice.summary}}" class="notice-summary">{{notice.summary}}</view></view></view>
  <view class="search-box"><text class="search-icon">⌕</text><input value="{{keyword}}" bindinput="search" placeholder="搜索商品、品牌或规格" placeholder-class="search-placeholder"/></view>
  <view class="sort-bar"><view class="sort-item {{sort === 'recommend' ? 'active' : ''}}" data-sort="recommend" bindtap="selectSort">为您推荐</view><view class="sort-item {{sort === 'sales' ? 'active' : ''}}" data-sort="sales" bindtap="selectSort">销量优先</view><view class="sort-item {{sort === 'price' ? 'active' : ''}}" data-sort="price" bindtap="selectSort">价格</view></view>
  <view wx:if="{{loading}}" class="muted center">正在加载商品...</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!loading && !error}}" class="catalog-shell"><scroll-view class="category-list" scroll-y><view wx:for="{{categories}}" wx:key="key" class="category-item {{activeCategory === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectCategory">{{item.name}}</view></scroll-view><scroll-view class="product-list" scroll-y><view wx:if="{{!visibleProducts.length}}" class="empty-state">没有找到匹配的商品</view><view wx:for="{{visibleProducts}}" wx:key="id" class="product-row" data-id="{{item.id}}" bindtap="openProduct"><image wx:if="{{item.imageUrl}}" class="product-image" lazy-load src="{{item.imageUrl}}" mode="aspectFit"/><view wx:else class="image-placeholder product-image">商品图片</view><view class="product-copy"><view class="product-name">{{item.name}}</view><view class="product-description">{{item.description || item.brand || item.category}}</view><view class="product-bottom"><view><view class="price">¥{{item.lowestPrice}}</view><view wx:if="{{item.outOfStock}}" class="out-of-stock">库存不足，联系商家</view></view><button wx:if="{{!item.outOfStock}}" class="add-button" data-id="{{item.id}}" catchtap="addToCart">+</button></view></view></view></scroll-view></view>
  <view class="mini-nav"><button class="mini-nav-item active" bindtap="openHome">首页</button><button class="mini-nav-item" bindtap="openCart">购物车</button><button class="mini-nav-item" bindtap="openMessages">消息</button><button class="mini-nav-item" bindtap="openOrders">订单</button><button class="mini-nav-item" bindtap="openProfile">我的</button></view>
</view>
