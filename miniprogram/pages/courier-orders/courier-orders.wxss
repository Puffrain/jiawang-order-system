.small { margin: 0; font-size: 24rpx; }
.order-card { margin-bottom: 24rpx; }
.filter-tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; overflow-x: auto; }.filter-tab { flex: 0 0 auto; margin: 0; padding: 12rpx 24rpx; border: 1rpx solid #e5e7eb; background: #fff; color: #74808c; font-size: 24rpx; }.filter-tab.selected { border-color: #fb923c; background: #fff4eb; color: #ea580c; }
.order-card { box-shadow: 0 6rpx 16rpx rgba(31,41,51,.05); }
.recipient-line, .address-line { line-height: 1.55; word-break: break-all; }
.actions button { min-width: 190rpx; }
