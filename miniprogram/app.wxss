page { background: #f3f4f6; color: #111827; font-size: 28rpx; }
button { border-radius: 12rpx; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }
.section { margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.muted { color: #6b7280; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-sizing: border-box; }
.primary { background: #f97316 !important; color: #fff !important; }
.danger { background: #fee2e2 !important; color: #b91c1c !important; }
.ghost { background: #fff !important; color: #374151 !important; border: 1rpx solid #d1d5db; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.actions button { margin: 0; font-size: 26rpx; }
