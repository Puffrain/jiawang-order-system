NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=/warehouse
ORDER_INTERNAL_URL=http://order-web:3000
INTEGRATION_SHARED_SECRET=replace-with-a-random-string-at-least-32-characters
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./proxy/certs
DATABASE_URL=file:/data/db/app.sqlite
DATABASE_PATH=/data/db/app.sqlite
DATA_DIR=/data
MEDIA_DIR=/media
PIPELINE_MEDIA_ROOT=/media
TEMP_DIR=/data/tmp
BACKUP_OUT_DIR=/data/backups
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_MASTER_KEY=replace-with-a-32-byte-base64-key
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_VISION_MODEL=
DEEPSEEK_TEXT_MODEL=
DEEPSEEK_MODELS_PATH=/models
DEEPSEEK_CHAT_PATH=/chat/completions
DEEPSEEK_INPUT_MODE=data_url
DEEPSEEK_INPUT_FORMAT=data_url
DEEPSEEK_ALLOWED_HOSTS=api.deepseek.com
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_PRICE_VERSION=
DEEPSEEK_PROMPT_PRICE_MINOR=0
DEEPSEEK_COMPLETION_PRICE_MINOR=0
DEEPSEEK_CURRENCY=CNY
# Optional JSON array, e.g. [{"model":"vision-model","version":"2026-08-01","currency":"CNY","promptPriceMinor":1,"completionPriceMinor":2}]
DEEPSEEK_PRICE_TABLE=
# Keep both browser request defenses enabled in every deployed environment.
# Local automation should send Origin and the jw_csrf double-submit token.
REQUIRE_ORIGIN=true
REQUIRE_CSRF=true
AI_JOB_TOKEN_LIMIT=100000
AI_DAILY_TOKEN_LIMIT=1000000
PIPELINE_TASK_TOKEN_LIMIT=100000
PIPELINE_DAILY_TOKEN_LIMIT=1000000
PIPELINE_COST_PER_TOKEN_MINOR=0
AI_CURRENCY=CNY
AI_MAX_CONCURRENCY=2
EXPORT_MAX_ROWS=50000
EXPORT_MAX_BYTES=268435456
EXPORT_RETENTION_DAYS=14
MAX_ZIP_BYTES=4294967296
MAX_EXTRACTED_BYTES=12884901888
MAX_ZIP_ENTRIES=10000
MAX_IMAGE_BYTES=52428800
MAX_IMAGE_PIXELS=40000000
